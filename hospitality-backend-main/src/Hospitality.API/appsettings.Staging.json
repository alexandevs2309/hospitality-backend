{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "localhost;staging.hospitality.example.com;app-staging.hospitality.example.com",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "HospitalityAPI_Staging",
    "Audience": "HospitalityClient_Staging",
    "ExpiryInMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "https://staging.hospitality.example.com",
      "https://app-staging.hospitality.example.com",
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "EnableSwaggerInProduction": true,
  "EnableDetailedErrors": true
}